# Contact form delivery — set one of the providers below.

# Formspree (https://formspree.io) — recommended for a quick start
FORMSPREE_FORM_ID=

# Resend (https://resend.com) — used when FORMSPREE_FORM_ID is empty
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=NESKI Studio <kontakt@neskistudio.pl>
# CONTACT_TO_EMAIL=kontakt@neskistudio.pl
